{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ProdexConfigFile",
    "definitions": {
        "ProdexConfigFile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "schema": {
                    "type": "string"
                },
                "version": {
                    "type": "number"
                },
                "output": {
                    "type": "object",
                    "properties": {
                        "dir": {
                            "type": "string"
                        },
                        "versioned": {
                            "type": "boolean"
                        },
                        "prefix": {
                            "type": "string"
                        },
                        "format": {
                            "type": "string",
                            "enum": [
                                "md",
                                "txt"
                            ]
                        }
                    },
                    "required": [
                        "dir",
                        "versioned",
                        "prefix",
                        "format"
                    ],
                    "additionalProperties": false
                },
                "entry": {
                    "type": "object",
                    "properties": {
                        "files": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "ui": {
                            "type": "object",
                            "properties": {
                                "roots": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "scanDepth": {
                                    "type": "number"
                                },
                                "priority": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "enablePicker": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "roots",
                                "scanDepth",
                                "priority"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "required": [
                        "files",
                        "ui"
                    ],
                    "additionalProperties": false
                },
                "resolve": {
                    "type": "object",
                    "properties": {
                        "include": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "aliases": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "exclude": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "depth": {
                            "type": "number"
                        },
                        "limit": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "include",
                        "aliases",
                        "exclude",
                        "depth",
                        "limit"
                    ],
                    "additionalProperties": false
                },
                "shortcuts": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/ProdexShortcut"
                    }
                }
            },
            "required": [
                "schema"
            ],
            "description": "Represents the user-saved config file (without runtime fields)."
        },
        "ProdexShortcut": {
            "type": "object",
            "properties": {
                "prefix": {
                    "type": "string"
                },
                "files": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "include": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}