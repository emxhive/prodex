{
    "version": 4,
    "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
    "output": {
        "dir": "prodex@prodex",
        "versioned": true,
        "format": "md"
    },

    "resolve": {
        "aliases": {
            "@": "resources/js"
        },
        "maxDepth": 10,
        "maxFiles": 200
    },
    "profiles": {
        "app": {
            "entry": [
                "src/index.ts"
            ]
        },
        "project": {
            "include": [
                ".github/**",
                "package.json",
                "prodex.json",
                "release-please-config.json",
                ".release-please-manifest.json",
                "CHANGELOG.md"
            ]
        }
    }
}