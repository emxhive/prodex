{
    "version": 5,
    "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
    "output": {
        "dir": "prodex@prodex",
        "versioned": true,
        "format": "md"
    },
    "aliases": {
        "@": "resources/js"
    },
    "depth": 10,
    "maxFiles": 200,
    "scopes": {
        "app": {
            "entry": [
                "src/index.ts"
            ]
        },
        "project": {
            "include": [
                ".github/**",
                "package.json",
                "prodex.json",
                "release-please-config.json",
                ".release-please-manifest.json",
                "CHANGELOG.md"
            ]
        }
    }
}