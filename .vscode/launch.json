{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Prodex",
      "program": "${workspaceFolder}/dist/debug.js",
      "runtimeArgs": ["--inspect-brk"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/src/**/*.ts"
      ],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
